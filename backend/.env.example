DATABASE_URL=postgresql://buena:buena@localhost:5432/buena
ENVIRONMENT=development

# Proposal engine: "stub" (deterministic, great for demos) or "ai" (requires API key)
PROPOSAL_ENGINE=stub

# AI keys (only needed when PROPOSAL_ENGINE=ai)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Slack outbound webhook URL (optional)
# To enable: create an Incoming Webhook in your Slack workspace settings
# Format: https://hooks.slack.com/services/T.../B.../...
# If not set, Slack notifications are skipped (audit log records the skip)
SLACK_WEBHOOK_URL=

# Frontend base URL for deep links in Slack notifications
APP_BASE_URL=http://localhost:3000
